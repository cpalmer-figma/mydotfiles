#!/usr/bin/env python3
"""tmux-resurrect post-save-layout hook: pin Codex/Claude panes to their session.

For every saved pane running Codex or Claude Code, rewrite the saved command to
`ai-resume <tool> <session-id|-> <dir>` so restoring reopens that pane's own
conversation instead of whichever one is most recent in the directory.

- Claude: ~/.claude/sessions/<pid>.json holds the live sessionId and cwd.
- Codex: the process keeps its rollout-<ts>-<uuid>.jsonl files open; the most
  recently written one is the active thread. Its cwd comes from state_*.sqlite.

Any failure leaves the save file untouched so saving never breaks.
"""

import glob
import json
import os
import re
import shlex
import sqlite3
import subprocess
import sys

AI_RESUME = os.path.expanduser("~/.tmux/scripts/ai-resume")
CLAUDE_DIR = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
ROLLOUT_RE = re.compile(r"^(?P<home>.*)/sessions/.*/rollout-.*-(?P<id>[0-9a-f-]{36})\.jsonl$")


def children_by_pid():
    children = {}
    for stat in glob.glob("/proc/[0-9]*/stat"):
        try:
            with open(stat) as f:
                fields = f.read().rsplit(")", 1)[1].split()
        except OSError:
            continue
        children.setdefault(int(fields[1]), []).append(int(stat.split("/")[2]))
    return children


def descendants(pid, children):
    """Breadth-first, so the outermost AI process in a pane is found first."""
    queue = [pid]
    while queue:
        current = queue.pop(0)
        yield current
        queue.extend(sorted(children.get(current, [])))


def comm(pid):
    try:
        with open(f"/proc/{pid}/comm") as f:
            return f.read().strip()
    except OSError:
        return ""


def proc_cwd(pid):
    try:
        return os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        return None


def claude_session(pid):
    try:
        with open(os.path.join(CLAUDE_DIR, "sessions", f"{pid}.json")) as f:
            info = json.load(f)
    except (OSError, ValueError):
        return None
    session_id = info.get("sessionId")
    cwd = info.get("cwd") or proc_cwd(pid)
    # A session with no messages has no transcript yet and can't be resumed.
    if not session_id or not glob.glob(os.path.join(CLAUDE_DIR, "projects", "*", f"{session_id}.jsonl")):
        session_id = None
    return session_id, cwd


def codex_thread_cwd(codex_home, thread_id):
    for db in sorted(glob.glob(os.path.join(codex_home, "state_*.sqlite")), reverse=True):
        try:
            conn = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=1)
            try:
                row = conn.execute("select cwd from threads where id = ?", (thread_id,)).fetchone()
            finally:
                conn.close()
        except sqlite3.Error:
            continue
        if row and row[0]:
            return row[0]
    return None


def codex_session(pid, children):
    newest = None
    for p in descendants(pid, children):
        for fd in glob.glob(f"/proc/{p}/fd/*"):
            try:
                target = os.readlink(fd)
                match = ROLLOUT_RE.match(target)
                if match:
                    mtime = os.stat(target).st_mtime
                    if newest is None or mtime > newest[0]:
                        newest = (mtime, match)
            except OSError:
                continue
    if newest is None:
        return None, proc_cwd(pid)
    match = newest[1]
    thread_id = match.group("id")
    return thread_id, codex_thread_cwd(match.group("home"), thread_id) or proc_cwd(pid)


def ai_command(pane_pid, children):
    for pid in descendants(pane_pid, children):
        name = comm(pid)
        if name == "claude" or os.path.exists(os.path.join(CLAUDE_DIR, "sessions", f"{pid}.json")):
            tool, (session_id, cwd) = "claude", claude_session(pid) or (None, proc_cwd(pid))
        elif name == "codex":
            tool, (session_id, cwd) = "codex", codex_session(pid, children)
        else:
            continue
        return " ".join([AI_RESUME, tool, shlex.quote(session_id or "-"), shlex.quote(cwd or os.getcwd())])
    return None


def main(state_file):
    listing = subprocess.run(
        ["tmux", "list-panes", "-a", "-F", "#{session_name}\t#{window_index}\t#{pane_index}\t#{pane_pid}"],
        capture_output=True, text=True, check=True,
    ).stdout
    pane_pids = {}
    for line in listing.splitlines():
        session, window, pane, pid = line.rsplit("\t", 3)
        pane_pids[(session, window, pane)] = int(pid)

    children = children_by_pid()
    with open(state_file) as f:
        lines = f.read().split("\n")
    changed = False
    for i, line in enumerate(lines):
        fields = line.split("\t")
        if fields[0] != "pane" or len(fields) < 11:
            continue
        pane_pid = pane_pids.get((fields[1], fields[2], fields[5]))
        command = pane_pid and ai_command(pane_pid, children)
        if command:
            fields[10] = ":" + command
            lines[i] = "\t".join(fields)
            changed = True
    if changed:
        with open(state_file, "w") as f:
            f.write("\n".join(lines))


if __name__ == "__main__":
    try:
        main(sys.argv[1])
    except Exception as error:  # never break a resurrect save
        print(f"ai-sessions-save: {error}", file=sys.stderr)
